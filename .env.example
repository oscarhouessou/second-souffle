# Copier en .env à la racine du dépôt (ADK remonte les dossiers pour le trouver).
# Ne jamais committer le .env.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ton-projet-gcp
GOOGLE_CLOUD_LOCATION=eu

# Modèles (NF08). Les quotas Vertex AI sont comptés par modèle et par région : répartir les rôles
# sur deux modèles augmente la capacité. Diagnostic (photos, compréhension) sur Flash, le reste sur Flash-Lite.
SECOND_SOUFFLE_MODEL=gemini-3.5-flash-lite
SECOND_SOUFFLE_MODEL_DIAGNOSTIC=gemini-3.6-flash
# Niveau de réflexion du modèle : minimal (rapide, par défaut), low, high
SECOND_SOUFFLE_THINKING=minimal

# Lot 4 : URL des cartes A2A (sinon les agents tournent dans le processus de l'orchestrateur)
# DIAGNOSTIC_AGENT_CARD_URL=http://localhost:8101/.well-known/agent-card.json
# REPAIR_AGENT_CARD_URL=http://localhost:8102/.well-known/agent-card.json
# VALUATION_AGENT_CARD_URL=http://localhost:8103/.well-known/agent-card.json
# JUDGE_AGENT_CARD_URL=http://localhost:8104/.well-known/agent-card.json

# Lot 5 : serveur MCP du catalogue (sinon fonctions locales)
# MCP_CATALOG_URL=http://localhost:8105/mcp
# Model Armor (optionnel) : nom complet du template, après activation de l'API modelarmor
# MODEL_ARMOR_TEMPLATE=projects/<projet>/locations/europe-west4/templates/<template>
# Contrôle LLM du ton par le juge (un appel de plus)
# JUGE_LLM=1
